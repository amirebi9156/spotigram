BOT_TOKEN=123456:ABC...
# supergroup id (with Topics enabled), looks like -100xxxxxxxxxx
CHAT_ID=-100xxxxxxxxxx

SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback

# optional
SYNC_INTERVAL=600
# comma-separated playlist ids; empty = all playlists
ONLY_PLAYLISTS=
# optional cookies.txt for yt-dlp if YouTube blocks the server
YTDLP_COOKIES=
