BOT_TOKEN=123456:ABC...
# supergroup id (with Topics enabled), looks like -100xxxxxxxxxx
CHAT_ID=-100xxxxxxxxxx

# optional
# playlist check interval, seconds
SYNC_INTERVAL=600
# new-release check interval, seconds (YouTube RSS + SoundCloud)
RELEASE_INTERVAL=180
# name of the topic that collects all new releases
RELEASES_TOPIC_NAME=🆕 New Releases
# ignore uploads older than this many hours, and songs outside this length range (seconds)
RELEASE_MAX_AGE_HOURS=72
RELEASE_MIN_SECONDS=60
RELEASE_MAX_SECONDS=720
# optional cookies.txt for yt-dlp if YouTube blocks the server
YTDLP_COOKIES=
